{
  "name": "obsidian-math-autocomplete",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=cjs --platform=browser --target=es2020 --external:obsidian --external:@codemirror/state --external:@codemirror/view --loader:.md=text --outfile=dist/main.js",
    "test": "node --test test/core.test.js test/objects.test.js test/explain.test.js test/textlink.test.js test/refs.test.js test/evidence.test.js test/work.test.js",
    "install-vault": "node scripts/install.mjs",
    "test:py": "node scripts/run-py-snippets.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  },
  "license": "MIT"
}
